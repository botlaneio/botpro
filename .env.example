# Copy to .env.local and fill in. Never commit the real file.

# Stripe restricted key with read access to Coupons. Lets the site show
# how many Founding Ten places are left. Without it the offer shows without a count.
STRIPE_SECRET_KEY=

# Contact form (Resend). The form shows an error and logs which of these is missing until all three are set.
RESEND_API_KEY=
# The inbox new briefs go to.
CONTACT_TO=
# The sender, on a domain verified in Resend, e.g. "Botlane <hello@botlane.io>".
CONTACT_FROM=
