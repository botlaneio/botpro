{
  // Botlane on Cloudflare Workers, through the OpenNext adapter. https://opennext.js.org/cloudflare
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "botpro",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // The site lives on botlane.io and www.botlane.io (custom domains, set in the dashboard). No second public
  // copy on workers.dev: without this, every deploy would switch it back on. Branch previews stay on.
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Lets the worker call itself, which OpenNext uses for revalidation. Must match "name".
      "binding": "WORKER_SELF_REFERENCE",
      "service": "botpro"
    }
  ],
  "r2_buckets": [
    {
      // Next.js's cache: today, the Founding Ten count from Stripe, refreshed every five minutes.
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "botpro-cache"
    }
  ],
  // Branch previews (wrangler preview) get their own cache bucket, so a preview never reads or writes
  // production's. The self-reference service isn't carried over: previews skip background revalidation.
  "previews": {
    "r2_buckets": [
      {
        "binding": "NEXT_INC_CACHE_R2_BUCKET",
        "bucket_name": "botpro-cache-preview"
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}
