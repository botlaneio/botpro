    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "developer-icons": "^7.1.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.62.0",
    "motion": "^14.7.1",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
